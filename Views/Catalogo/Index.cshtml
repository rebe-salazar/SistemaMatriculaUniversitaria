@model IEnumerable<SistemaMatriculaUniversitaria.Models.Carrera>

@{
    ViewData["Title"] = "Carreras disponibles";
}

<h1>Carreras disponibles</h1>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No hay carreras registradas en este momento.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var carrera in Model)
            {
                <tr>
                    <td>@carrera.Nombre</td>
                    <td>@carrera.Descripcion</td>
                </tr>
            }
        </tbody>
    </table>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mb-3">
    Volver al inicio
</a>