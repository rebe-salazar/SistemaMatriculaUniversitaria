@model SistemaMatriculaUniversitaria.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Ha ocurrido un error!.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de Desarrollo</h3>
<p>
    Al cambiar al entorno de <strong>Desarrollo</strong>, se mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno de desarrollo no debe habilitarse en aplicaciones en producción.</strong>
    Esto puede provocar la exposición de información sensible a los usuarios finales.
    Para depuración local, puedes habilitar el entorno de <strong>Desarrollo</strong> configurando la variable de entorno
    <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong> y reiniciando la aplicación.
</p>
