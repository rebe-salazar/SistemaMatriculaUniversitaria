@model IEnumerable<SistemaMatriculaUniversitaria.Models.Docente>

@{
    ViewData["Title"] = "Listado de docentes";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    bool? activo = ViewBag.Activo;
    string buscar = ViewBag.Buscar as string ?? "";
}

<h1>Docentes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar docente</a>
</p>

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text"
                   name="buscar"
                   value="@buscar"
                   class="form-control"
                   placeholder="Buscar por nombre, correo o especialidad" />
        </div>

        <div class="col-md-3">
            <select name="activo" class="form-control">
                <option value="">-- Todos los estados --</option>
                <option value="true" selected="@(activo == true)">Activos</option>
                <option value="false" selected="@(activo == false)">Inactivos</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>

        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No hay docentes registrados con los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Nombre completo</th>
                    <th>Correo</th>
                    <th>Especialidad</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Correo</td>
                        <td>@item.Especialidad</td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.DocenteId" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.DocenteId" class="btn btn-info btn-sm">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.DocenteId" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-buscar="@buscar"
                           asp-route-activo="@activo">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mb-3">
    Volver al inicio
</a>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const inputBuscar = document.querySelector('input[name="buscar"]');
            const selectActivo = document.querySelector('select[name="activo"]');
            const filas = document.querySelectorAll("tbody tr");

            function filtrar() {
                let texto = inputBuscar.value.toLowerCase();
                let estado = selectActivo.value;

                filas.forEach(fila => {
                    let contenido = fila.innerText.toLowerCase();

                    let cumpleTexto = contenido.includes(texto);

                    let cumpleEstado = true;

                    if (estado === "true") {
                        cumpleEstado = fila.innerText.includes("Activo");
                    } else if (estado === "false") {
                        cumpleEstado = fila.innerText.includes("Inactivo");
                    }

                    fila.style.display = (cumpleTexto && cumpleEstado) ? "" : "none";
                });
            }

            inputBuscar.addEventListener("keyup", filtrar);
            selectActivo.addEventListener("change", filtrar);

        });
    </script>
}