@model SistemaMatriculaUniversitaria.Models.Docente

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar docente</h1>
<h3>¿Está seguro de que desea eliminar este docente?</h3>

<div>
    <h4>Docente</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NombreCompleto)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NombreCompleto)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Correo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Correo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Especialidad)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Especialidad)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Activo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Activo)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="DocenteId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index">Volver al listado</a>
    </form>
</div>
<a asp-action="Index" class="btn btn-secondary">
    Volver al listado
</a>
