@model SistemaMatriculaUniversitaria.Models.Curso

@{
    ViewData["Title"] = "Eliminar curso";
}

<h1>Eliminar curso</h1>

<div class="alert alert-danger">
    ¿Está segura de que desea eliminar este curso?
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Nombre</h5>
        <p class="card-text">
            <strong>Créditos:</strong> @Model.Creditos
        </p>
        <p class="card-text">
            <strong>Carrera:</strong> @Model.Carrera?.Nombre
        </p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="CursoId" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
<a asp-action="Index" class="btn btn-secondary">
    Volver al listado
</a>