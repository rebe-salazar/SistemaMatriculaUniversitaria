@model SistemaMatriculaUniversitaria.Models.Carrera

@{
    ViewData["Title"] = "Eliminar carrera";
}

<h1>Eliminar carrera</h1>

<div class="alert alert-danger">
    ¿Está segura de que desea eliminar esta carrera?
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Nombre</h5>
        <p class="card-text">
            <strong>Descripción:</strong> @Model.Descripcion
        </p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <!-- ID oculto -->
    <input type="hidden" asp-for="CarreraId" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
<a asp-action="Index" class="btn btn-secondary">
    Volver al listado
</a>