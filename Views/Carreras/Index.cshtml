@model IEnumerable<SistemaMatriculaUniversitaria.Models.Carrera>

@{
    ViewData["Title"] = "Listado de carreras";
}

<h1>Listado de carreras</h1>

<p>
    <!-- Botón para ir a crear una nueva carrera -->
    <a asp-action="Create" class="btn btn-primary">Agregar nueva carrera</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var carrera in Model)
        {
            <tr>
                <td>@carrera.Nombre</td>
                <td>@carrera.Descripcion</td>
                <td>
                    <!-- Acciones del CRUD -->
                    <a asp-action="Edit" asp-route-id="@carrera.CarreraId" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@carrera.CarreraId" class="btn btn-info btn-sm">Detalle</a>
                    <a asp-action="Delete" asp-route-id="@carrera.CarreraId" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>