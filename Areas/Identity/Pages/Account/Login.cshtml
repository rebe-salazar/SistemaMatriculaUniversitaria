@page
@model SistemaMatriculaUniversitaria.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="tarjeta-formulario">
    <h1 class="titulo-formulario">Iniciar sesión</h1>
    <p class="subtitulo-formulario">
        Accede al sistema para consultar información académica y gestionar el proceso de matrícula.
    </p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Campo de correo electrónico -->
        <div class="form-floating mb-3">
            <input asp-for="Input.Correo" class="form-control" autocomplete="username" placeholder="correo@ejemplo.com" />
            <label asp-for="Input.Correo">Correo electrónico</label>
            <span asp-validation-for="Input.Correo" class="text-danger"></span>
        </div>

        <!-- Campo de contraseña -->
        <div class="form-floating mb-3">
            <input asp-for="Input.Contrasena" class="form-control" autocomplete="current-password" placeholder="Contraseña" />
            <label asp-for="Input.Contrasena">Contraseña</label>
            <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
        </div>

        <!-- Casilla recordar sesión -->
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="Input.Recordarme" />
            <label class="form-check-label" asp-for="Input.Recordarme">
                Recordarme
            </label>
        </div>

        <!-- Botón principal -->
        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary btn-lg">Ingresar</button>
        </div>

        <!-- Enlace de registro -->
        <div class="text-center">
            <p class="mb-0">
                ¿No tienes una cuenta?
                <a asp-page="./Register">Registrarse</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}