@page
@model SistemaMatriculaUniversitaria.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <h4>Use su cuenta para ingresar al sistema</h4>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Correo" class="form-control" autocomplete="username" />
                <label asp-for="Input.Correo">Correo electrónico</label>
                <span asp-validation-for="Input.Correo" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Contrasena" class="form-control" autocomplete="current-password" />
                <label asp-for="Input.Contrasena">Contraseña</label>
                <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
            </div>

            <div class="checkbox mb-3">
                <label asp-for="Input.Recordarme" class="form-label">
                    <input class="form-check-input" asp-for="Input.Recordarme" />
                    Recordarme
                </label>
            </div>

            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Ingresar</button>
            </div>

            <div class="mt-3">
                <p>
                    <a asp-page="./Register">Registrarse como nuevo usuario</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}