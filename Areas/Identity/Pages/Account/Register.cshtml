@page
@model SistemaMatriculaUniversitaria.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<h1>Registro</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <h4>Crear una cuenta nueva</h4>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Correo" class="form-control" autocomplete="username" />
                <label asp-for="Input.Correo">Correo electrónico</label>
                <span asp-validation-for="Input.Correo" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Contrasena" class="form-control" autocomplete="new-password" />
                <label asp-for="Input.Contrasena">Contraseña</label>
                <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <label asp-for="Input.ConfirmarContrasena">Confirmar contraseña</label>
                <span asp-validation-for="Input.ConfirmarContrasena" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Registrarse</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}