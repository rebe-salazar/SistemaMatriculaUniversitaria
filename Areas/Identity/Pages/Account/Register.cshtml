@page
@model SistemaMatriculaUniversitaria.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<div class="tarjeta-formulario">
    <h1 class="titulo-formulario">Registro de usuario</h1>
    <p class="subtitulo-formulario">
        Crea una cuenta para acceder al sistema de matrícula universitaria.
    </p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Campo de correo electrónico -->
        <div class="form-floating mb-3">
            <input asp-for="Input.Correo" class="form-control" autocomplete="username" placeholder="correo@ejemplo.com" />
            <label asp-for="Input.Correo">Correo electrónico</label>
            <span asp-validation-for="Input.Correo" class="text-danger"></span>
        </div>

        <!-- Campo de contraseña -->
        <div class="form-floating mb-3">
            <input asp-for="Input.Contrasena" class="form-control" autocomplete="new-password" placeholder="Contraseña" />
            <label asp-for="Input.Contrasena">Contraseña</label>
            <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
        </div>

        <!-- Campo para confirmar contraseña -->
        <div class="form-floating mb-3">
            <input asp-for="Input.ConfirmarContrasena" class="form-control" autocomplete="new-password" placeholder="Confirmar contraseña" />
            <label asp-for="Input.ConfirmarContrasena">Confirmar contraseña</label>
            <span asp-validation-for="Input.ConfirmarContrasena" class="text-danger"></span>
        </div>

        <!-- Botón principal -->
        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary btn-lg">Registrarse</button>
        </div>

        <!-- Enlace para volver al login -->
        <div class="text-center">
            <p class="mb-0">
                ¿Ya tienes una cuenta?
                <a asp-page="./Login">Iniciar sesión</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}